# ==========================================
# BURHAN STORE - Environment Configuration
# ==========================================

# 1. MongoDB Atlas Connection URI
# Supported in documented priority order: MONGODB_URI, MONGODB_URL, MONGO_URL, DATABASE_URL.
# Required for multi-container / serverless database persistence.
# Can be configured via Vercel as MONGODB_URI or MONGODB_URL,
# or copied from MongoDB Atlas -> Connect -> Drivers (Node.js).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/burhanstore?retryWrites=true&w=majority
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/burhanstore?retryWrites=true&w=majority

# 2. JWT Authentication Secret
# Used to sign and verify admin session tokens.
# Required in production. Do not use a source-controlled/default value.
JWT_SECRET=
# Optional higher-priority name accepted by the admin auth module.
# ADMIN_JWT_SECRET=

# Optional first-admin bootstrap password. If unset, no admin is auto-created.
# ADMIN_INITIAL_PASSWORD=

# 3. Store Public Base URL
# Used for canonical SEO tags, OpenGraph sharing cards, sitemap, and robots.txt.
NEXT_PUBLIC_BASE_URL=https://burhanstore.com

# 4. Optional Configurations
# DB_NAME=burhanstore
# CORS_ORIGINS=https://burhanstore.com

# 5. Optional transactional email (Resend)
# Leave EMAIL_PROVIDER empty to disable email safely.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=orders@your-verified-domain.example
